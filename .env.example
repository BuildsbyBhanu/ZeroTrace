# ZeroTrace Configuration Example
# Copy this file to .env and customize as needed

# ── Application ────────────────────────────────
ZEROTRACE_APP_NAME=ZeroTrace
ZEROTRACE_APP_VERSION=0.1.0
ZEROTRACE_DEBUG=false
ZEROTRACE_HOST=127.0.0.1
ZEROTRACE_PORT=8000

# ── Database ───────────────────────────────────
# SQLite (default for single-user/dev)
ZEROTRACE_DATABASE_URL=sqlite+aiosqlite:///./data/zerotrace.db

# PostgreSQL (for production/multi-user)
# ZEROTRACE_DATABASE_URL=postgresql+asyncpg://localhost:5432/zerotrace

# ── Scan Engine Defaults ──────────────────────
ZEROTRACE_MAX_CONCURRENCY=10
ZEROTRACE_REQUESTS_PER_SECOND=10.0
ZEROTRACE_CONNECTION_TIMEOUT=10.0
ZEROTRACE_READ_TIMEOUT=30.0
ZEROTRACE_TOTAL_SCAN_TIMEOUT=600.0
ZEROTRACE_MAX_REDIRECT_DEPTH=5
ZEROTRACE_MAX_REQUESTS_PER_SCAN=5000

# ── SSRF Protection ────────────────────────────
# Allow scanning localhost/127.0.0.1 for local development/testing
# CAUTION: Only set to true in development environments!
# FALSE (default) = Blocks all private IP ranges including localhost for security
# TRUE = Allows localhost/127.0.0.1 but still blocks cloud metadata endpoints
#        (169.254.169.254) and non-loopback private networks (10.x, 172.16-31.x, 192.168.x)
ZEROTRACE_ALLOW_LOCALHOST=false

# ── Security ───────────────────────────────────
# ZEROTRACE_CREDENTIAL_ENCRYPTION_KEY=<base64-encoded-32-byte-key>

# ── Logging ───────────────────────────────────
ZEROTRACE_LOG_LEVEL=INFO
ZEROTRACE_LOG_FORMAT=json

# ── Manual Verification Instructions ─────────────
# To test local scan functionality with allow_localhost=true:
#
# 1. Start a local test server:
#    python -m zerotrace.test_server 8889 --weak
#
# 2. Set the environment variable:
#    export ZEROTRACE_ALLOW_LOCALHOST=true   (Linux/Mac)
#    $env:ZEROTRACE_ALLOW_LOCALHOST="true"    (Windows PowerShell)
#
# 3. Start the application:
#    python -m zerotrace
#
# 4. Submit a scan via API:
#    curl -X POST http://localhost:8000/api/v1/scans \
#      -H "Content-Type: application/json" \
#      -d '{"target_url":"http://127.0.0.1:8889/","profile":"quick"}'
#
# 5. Check scan results:
#    curl http://localhost:8000/scan/{scan_id}
#
# Expected findings for weak server (port 8889):
#   - Missing X-Frame-Options (clickjacking protection)
#   - Missing Strict-Transport-Security (HSTS)
#   - Missing Content-Security-Policy
#   - Server version disclosure (Apache/2.4.52)
#   - X-Powered-By header disclosure (PHP/8.1.12)
#
# SSRF Protection Verification:
#   - Scanning 127.0.0.1 without ZEROTRACE_ALLOW_LOCALHOST=true: BLOCKED
#   - Scanning 169.254.169.254 with ZEROTRACE_ALLOW_LOCALHOST=true: BLOCKED
#   - Scanning 10.x.x.x or 192.168.x.x: BLOCKED
#   - Scanning localhost with ZEROTRACE_ALLOW_LOCALHOST=true: ALLOWED